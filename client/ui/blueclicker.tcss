#app-container {
    layout: grid;
    grid-size: 2 2;
    grid-columns: 3fr 1fr;
    grid-rows: 1fr 1fr;
    height: 100%;
}

#log {
    row-span: 2;
}

#key-table {
    height: 100%;
}

#key-cooldown {
    height: 100%;
}

KeyCooldown {
    height: 1;
}

AddKeyScreen {
    align: center middle;

    #add-modal-dialog {
        width: 46;
        height: auto;
        border: solid $primary;
        background: $panel;
        padding: 1 2;
    }

    #label {
        width: 100%;
        margin: 0 0 1 0;
        content-align: center middle;
    }

    .input-group {
        width: 100%;
        height: auto;
        margin-bottom: 1;
    }

    .input-group Input {
        width: 100%;
    }

    .error {
        color: $error;
        height: 1;
        margin: 0 1 0 1;
        padding-left: 3;
        width: 100%;
    }

    .hidden {
        display: none;
    }

    /* Priority Grouping */
    #priority-group {
        width: 100%;
        height: auto;
        margin-top: 1;
        margin: 1;
    }

    #priority-header-row {
        width: 100%;
        height: 3;
        layout: horizontal;
        align: left middle;
    }

    #priority-title {
        width: auto;
        height: 1;
        text-style: bold;
        color: $text-muted;
    }

    #prio-display {
        width: 4;
        height: 1;
        content-align: center middle;
    }

    #prio-help {
        color: rgba(255, 255, 255, 0.5);
    }

    /* The Single Line Meter */
    #meter-bar {
        width: 100%;       
        background: $surface;
        height: 1;
        margin-top: 0;
    }

    /* Action Buttons */
    #bottom-container {
        width: 100%;       
        height: auto;
        margin-top: 2;
        layout: horizontal;
    }

    #bottom-container Button {
        width: 1fr;         
        margin: 0 2;
    }
}

